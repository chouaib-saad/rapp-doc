\newacro{API}[\AC@hyperlink{API}{API}]{Application Programming Interface, interface de programmation applicative}
\newacro{ASR}[\AC@hyperlink{ASR}{ASR}]{Automatic Speech Recognition, reconnaissance automatique de la parole}
\newacro{BM25}[\AC@hyperlink{BM25}{BM25}]{Best Matching 25, fonction de pondération lexicale}
\newacro{CER}[\AC@hyperlink{CER}{CER}]{Character Error Rate, taux d'erreur sur les caractères}
\newacro{CIN}[\AC@hyperlink{CIN}{CIN}]{Carte d'Identité Nationale}
\newacro{CQRS}[\AC@hyperlink{CQRS}{CQRS}]{Command Query Responsibility Segregation, séparation des responsabilités de commande et de requête}
\newacro{DDD}[\AC@hyperlink{DDD}{DDD}]{Domain Driven Design, conception pilotée par le domaine}
\newacro{DER}[\AC@hyperlink{DER}{DER}]{Diarization Error Rate, taux d'erreur de segmentation en locuteurs}
\newacro{G2P}[\AC@hyperlink{G2P}{G2P}]{Grapheme to Phoneme, conversion graphème phonème}
\newacro{GLPI}[\AC@hyperlink{GLPI}{GLPI}]{Gestionnaire Libre de Parc Informatique}
\newacro{HNSW}[\AC@hyperlink{HNSW}{HNSW}]{Hierarchical Navigable Small World, structure d'index vectoriel}
\newacro{HTTP}[\AC@hyperlink{HTTP}{HTTP}]{HyperText Transfer Protocol}
\newacro{IDF}[\AC@hyperlink{IDF}{IDF}]{Inverse Document Frequency, fréquence inverse de document}
\newacro{ITN}[\AC@hyperlink{ITN}{ITN}]{Inverse Text Normalization, normalisation inverse du texte}
\newacro{JWT}[\AC@hyperlink{JWT}{JWT}]{JSON Web Token, jeton d'accès signé}
\newacro{LLM}[\AC@hyperlink{LLM}{LLM}]{Large Language Model, grand modèle de langue}
\newacro{MCD}[\AC@hyperlink{MCD}{MCD}]{Mel Cepstral Distortion, distorsion cepstrale sur l'échelle de Mel}
\newacro{MCP}[\AC@hyperlink{MCP}{MCP}]{Model Context Protocol, protocole de mise à disposition de capacités}
\newacro{MFCC}[\AC@hyperlink{MFCC}{MFCC}]{Mel Frequency Cepstral Coefficients, coefficients cepstraux sur l'échelle de Mel}
\newacro{MOS}[\AC@hyperlink{MOS}{MOS}]{Mean Opinion Score, note moyenne d'opinion}
\newacro{MSISDN}[\AC@hyperlink{MSISDN}{MSISDN}]{Mobile Station International Subscriber Directory Number, numéro d'appel de l'abonné}
\newacro{NVMe}[\AC@hyperlink{NVMe}{NVMe}]{Non Volatile Memory express, interface de stockage à semi conducteurs}
\newacro{ONNX}[\AC@hyperlink{ONNX}{ONNX}]{Open Neural Network Exchange, format d'échange de modèles}
\newacro{OTel}[\AC@hyperlink{OTel}{OTel}]{OpenTelemetry, cadre de collecte de traces et de métriques}
\newacro{PESQ}[\AC@hyperlink{PESQ}{PESQ}]{Perceptual Evaluation of Speech Quality, évaluation perceptuelle de la qualité vocale}
\newacro{PII}[\AC@hyperlink{PII}{PII}]{Personally Identifiable Information, données à caractère personnel}
\newacro{RAG}[\AC@hyperlink{RAG}{RAG}]{Retrieval Augmented Generation, génération augmentée par récupération}
\newacro{RBAC}[\AC@hyperlink{RBAC}{RBAC}]{Role Based Access Control, contrôle d'accès fondé sur les rôles}
\newacro{REST}[\AC@hyperlink{REST}{REST}]{Representational State Transfer, style d'architecture d'interface applicative}
\newacro{RRF}[\AC@hyperlink{RRF}{RRF}]{Reciprocal Rank Fusion, fusion par rangs réciproques}
\newacro{RTF}[\AC@hyperlink{RTF}{RTF}]{Real Time Factor, facteur temps réel}
\newacro{SIM}[\AC@hyperlink{SIM}{SIM}]{Subscriber Identity Module, module d'identité de l'abonné}
\newacro{SIP}[\AC@hyperlink{SIP}{SIP}]{Session Initiation Protocol, protocole d'établissement de session}
\newacro{SMTP}[\AC@hyperlink{SMTP}{SMTP}]{Simple Mail Transfer Protocol}
\newacro{SNR}[\AC@hyperlink{SNR}{SNR}]{Signal to Noise Ratio, rapport signal sur bruit}
\newacro{SOLID}[\AC@hyperlink{SOLID}{SOLID}]{Single responsibility, Open closed, Liskov substitution, Interface segregation, Dependency inversion}
\newacro{SSML}[\AC@hyperlink{SSML}{SSML}]{Speech Synthesis Markup Language, langage de balisage pour la synthèse vocale}
\newacro{STOI}[\AC@hyperlink{STOI}{STOI}]{Short Time Objective Intelligibility, intelligibilité objective à court terme}
\newacro{STT}[\AC@hyperlink{STT}{STT}]{Speech To Text, transcription de la parole en texte}
\newacro{TND}[\AC@hyperlink{TND}{TND}]{Dinar tunisien}
\newacro{TTFA}[\AC@hyperlink{TTFA}{TTFA}]{Time To First Audio, délai avant le premier fragment audio}
\newacro{TTFB}[\AC@hyperlink{TTFB}{TTFB}]{Time To First Byte, délai avant le premier octet}
\newacro{TTFT}[\AC@hyperlink{TTFT}{TTFT}]{Time To First Token, délai avant le premier jeton}
\newacro{TTS}[\AC@hyperlink{TTS}{TTS}]{Text To Speech, synthèse vocale}
\newacro{UML}[\AC@hyperlink{UML}{UML}]{Unified Modeling Language, langage de modélisation unifié}
\newacro{UUID}[\AC@hyperlink{UUID}{UUID}]{Universally Unique Identifier, identifiant universellement unique}
\newacro{VAD}[\AC@hyperlink{VAD}{VAD}]{Voice Activity Detection, détection d'activité vocale}
\newacro{WebRTC}[\AC@hyperlink{WebRTC}{WebRTC}]{Web Real Time Communication, communication temps réel pour le web}
\newacro{WER}[\AC@hyperlink{WER}{WER}]{Word Error Rate, taux d'erreur sur les mots}
\newacro{WIL}[\AC@hyperlink{WIL}{WIL}]{Word Information Lost, information de mot perdue}
